{
	"name": "@anyknown/ui",
	"version": "0.1.0",
	"description": "AnyKnown design system — StyleX tokens, themes, and 34 components",
	"license": "MIT",
	"files": [
		"dist",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tokens.stylex": {
			"types": "./dist/tokens.stylex.d.ts",
			"default": "./dist/tokens.stylex.js"
		},
		"./themes.stylex": {
			"types": "./dist/themes.stylex.d.ts",
			"default": "./dist/themes.stylex.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./scrollbar.css": "./dist/scrollbar.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/esm-extensions.mjs && cp src/tokens.css src/scrollbar.css dist/",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint src",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "turbo run typecheck lint fmt:check",
		"test": "vitest run",
		"playground": "vite --config playground/vite.config.ts",
		"site": "vite --config site/vite.config.ts",
		"site:test": "vitest run --config site/smoke.config.ts",
		"site:build": "pnpm build && vite build --config site/vite.config.ts",
		"site:deploy": "pnpm site:build && npx wrangler deploy --config site/wrangler.jsonc",
		"prepublishOnly": "pnpm check && pnpm test && pnpm verify:pack",
		"verify:pack": "pnpm build && node scripts/verify-pack.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@stylexjs/stylex": "^0.19.0",
		"diff": "^9.0.0"
	},
	"devDependencies": {
		"@babel/core": "^8.0.1",
		"@stylexjs/babel-plugin": "0.19.0",
		"@stylexjs/postcss-plugin": "0.19.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.5.4",
		"jsdom": "^30.0.1",
		"marked": "^18.0.11",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"postcss": "^8.5.26",
		"react-dom": "^19.2.8",
		"turbo": "^2.10.9",
		"typescript": "^5.9.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"packageManager": "pnpm@10.30.3"
}
